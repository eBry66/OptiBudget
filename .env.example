# Supabase project URL and publishable (public) key: consumed by @supabase/supabase-js
# and @supabase/ssr to create the browser and server clients (engineering/ARCHITECTURE.md,
# Stack: Data access). NEXT_PUBLIC_ so the browser-side client can read them. Publishable
# key, not the legacy anon key: Supabase's current quickstart names this variable and its
# docs state the legacy anon/service_role keys are deprecated by end of 2026.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase service_role key. Server-side only: never a NEXT_PUBLIC_ variable, never set
# in Preview, Production environment only (engineering/THREAT_MODEL.md, "The service_role
# boundary"; orchestration/HITL_GUIDE.md §8.4). No request-serving code path uses it
# (engineering/ARCHITECTURE.md, "Why not an ORM") — reserved for out-of-band administrative
# scripts, which are themselves prohibited from writing households or household_members rows.
SUPABASE_SERVICE_ROLE_KEY=
